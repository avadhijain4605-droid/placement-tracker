# Server environment variables
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.

# MongoDB connection string.
# Local: mongodb://127.0.0.1:27017/placement_tracker
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/placement_tracker
MONGODB_URI=mongodb://127.0.0.1:27017/placement_tracker

# Port the Express API listens on
PORT=5000

# Google Gemini API key (used ONLY on the backend)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend origin allowed to call this API (use * for dev)
CLIENT_ORIGIN=http://localhost:5173
